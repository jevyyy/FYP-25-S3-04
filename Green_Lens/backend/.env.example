# Backend Configuration
# Copy this file to .env and update with your values

# Model Configuration
MODEL_PATH=../../output_model/flower_img_classifier.keras
CLASS_NAMES_PATH=../../output_model/class_names.json

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# Input Configuration
INPUT_WIDTH=224
INPUT_HEIGHT=224

# API Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB max file upload
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif
