# Backend API Configuration
# Copy this file to .env and update with your settings

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Model Configuration
MODEL_PATH=../Green_Lens/backend/src/ouput_model/flower_img_classifier.keras
CLASS_NAMES_PATH=../Green_Lens/backend/src/camera/class_names.json
CLASS_DICT_PATH=../Green_Lens/backend/src/camera/classes_to_name_dictionary.json

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=*

# Optional: Limit file upload size (in MB)
MAX_CONTENT_LENGTH=16

# Optional: Enable debug mode (set to False in production)
DEBUG=True
