# Backend API Configuration
# 
# IMPORTANT: Copy this file to .env and update with your values
# Command: cp .env.example .env

# Backend API URL
# 
# FOR TESTING ON PHYSICAL DEVICE (iPhone/Android with Expo Go):
# 1. Find your computer's IP address:
#    - Windows: ipconfig (look for IPv4 Address)
#    - Mac/Linux: ifconfig (look for inet under en0 or wlan0)
# 2. Replace "localhost" below with your computer's IP address
#    Example: EXPO_PUBLIC_API_URL=http://160.197.1.100:5000
# 3. Make sure your phone and computer are on the SAME WiFi network
# 4. Restart Expo after changing this file: npx expo start
#
# FOR TESTING ON EMULATOR/SIMULATOR:
# Use localhost (emulators can reach the host machine)
EXPO_PUBLIC_API_URL=http://localhost:5000

# For production (uncomment and set your production URL):
# EXPO_PUBLIC_API_URL=https://your-api-domain.com

# NOTE: The .env file is git-ignored (safe, won't be committed to GitHub)
# This is just a template for you to copy and customize
